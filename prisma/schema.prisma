// Bazen Bar & BBQ — urnik in evidenca delovnega časa
// Shema je brez enumov, da ostane prenosljiva med bazami.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Zaposleni. Prijava poteka s 4-mestnim PIN-om, ki je shranjen zgoščen (bcrypt).
model Employee {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  /// "employee" | "manager" | "admin" — glej src/lib/roles.ts
  role       String   @default("employee")
  pinHash    String
  /// Neobvezna bruto urna postavka, uporabljena samo v izvozu.
  hourlyRate Float?
  /// Želeno število ur na teden; upošteva ga samodejno sestavljanje urnika.
  weeklyHoursTarget Float?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shifts        Shift[]     @relation("ShiftEmployee")
  createdShifts Shift[]     @relation("ShiftCreatedBy")
  timeEntries   TimeEntry[] @relation("EntryEmployee")
  editedEntries TimeEntry[] @relation("EntryEditedBy")

  availability    Availability[] @relation("AvailabilityEmployee")
  skills          EmployeeSkill[] @relation("SkillEmployee")
  absences        Absence[]    @relation("AbsenceEmployee")
  decidedAbsences Absence[]    @relation("AbsenceDecidedBy")
  offeredShifts   ShiftOffer[] @relation("OfferOfferedBy")
  claimedShifts   ShiftOffer[] @relation("OfferClaimedBy")
  decidedOffers   ShiftOffer[] @relation("OfferDecidedBy")

  @@index([active, lastName])
}

/// Načrtovana izmena v urniku.
model Shift {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("ShiftEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  start      DateTime
  end        DateTime
  /// Delovno mesto kot besedilo (ostane zapisano tudi, če se šifrant spremeni).
  position   String?
  /// "dopoldan" | "celodnevna" | "popoldan" — glej src/lib/parts-of-day.ts
  partOfDay  String?
  /// Povezava na šifrant delovnih mest, kadar je izmena z njega.
  positionId String?
  positionRef Position? @relation("ShiftPosition", fields: [positionId], references: [id], onDelete: SetNull)
  note       String?

  createdById String?
  createdBy   Employee? @relation("ShiftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Ponudba za oddajo te izmene, če je bila oddana.
  offer ShiftOffer?

  timeEntries TimeEntry[] @relation("EntryShift")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, start])
  @@index([start])
}

/// Dejansko opravljen čas (prijava/odjava na uro).
model TimeEntry {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation("EntryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn      DateTime
  /// null = izmena še traja
  clockOut     DateTime?
  breakMinutes Int       @default(0)
  note         String?

  /// Načrtovana izmena, na katero se je zaposleni prijavil (če je bila vpisana).
  shiftId String?
  shift   Shift?  @relation("EntryShift", fields: [shiftId], references: [id], onDelete: SetNull)

  /// Zamuda za načrtovanim začetkom in odbitek, izračunan ob prijavi.
  /// Zapišemo ju, da poznejša sprememba pravil ne spremeni že obračunanih ur.
  lateMinutes    Int @default(0)
  penaltyMinutes Int @default(0)

  /// Sledljivost ročnih popravkov — kdo in kdaj je vnos spremenil.
  editedById String?
  editedBy   Employee? @relation("EntryEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, clockIn])
  @@index([clockIn])
}

/// Šifrant delovnih mest (šank, kuhinja, strežba, bazen …).
model Position {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  skills    EmployeeSkill[] @relation("SkillPosition")
  templates ShiftTemplate[] @relation("TemplatePosition")
  shifts    Shift[]         @relation("ShiftPosition")

  createdAt DateTime @default(now())
}

/// Kako dobro zaposleni pokriva posamezno delovno mesto: 0 = ne dela tega,
/// 1 = začetnik … 5 = povsem samostojen.
model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("SkillEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  positionId String
  position   Position @relation("SkillPosition", fields: [positionId], references: [id], onDelete: Cascade)
  level      Int      @default(0)

  @@unique([employeeId, positionId])
}

/// Prednastavljena izmena za posamezen dan v tednu — podlaga za samodejno
/// sestavljanje urnika.
model ShiftTemplate {
  id         String   @id @default(cuid())
  /// 1 = ponedeljek … 7 = nedelja
  weekday    Int
  /// "dopoldan" | "celodnevna" | "popoldan"
  partOfDay  String   @default("popoldan")
  positionId String
  position   Position @relation("TemplatePosition", fields: [positionId], references: [id], onDelete: Cascade)
  startTime  String
  endTime    String
  /// Koliko ljudi je za to izmeno potrebnih.
  peopleNeeded Int @default(1)
  /// Najnižja ocena, ki jo mora imeti razporejeni za to delovno mesto.
  minLevel     Int @default(1)
  /// Če je nastavljeno, mora biti med razporejenimi vsaj eden s to oceno ali več.
  leadLevel    Int?
  active       Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([weekday])
}

/// Tedenska razpoložljivost zaposlenega, ločeno za dopoldne in popoldne.
///
/// Razpoložljivost se vodi po istih delih dneva kot izmene, da jo samodejni
/// urnik lahko dejansko upošteva. Celodnevna izmena zahteva razpoložljivost v
/// obeh delih, zato zanjo ni svoje vrstice.
model Availability {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("AvailabilityEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  /// 1 = ponedeljek … 7 = nedelja
  weekday    Int
  /// "dopoldan" | "popoldan" — glej AVAILABILITY_PARTS v src/lib/parts-of-day.ts
  partOfDay  String   @default("dopoldan")
  /// "yes" | "maybe" | "no" — glej src/lib/availability.ts
  status     String   @default("yes")
  note       String?
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, weekday, partOfDay])
}

/// Dodatek na urno postavko za določen dan v tednu ali za konkreten datum.
/// Pravilo za konkreten datum ima prednost pred pravilom za dan v tednu.
/// Dodatki se upoštevajo ob izračunu, zato jih je mogoče dodati tudi za nazaj.
model PayRule {
  id     String @id @default(cuid())
  /// "weekday" | "date"
  scope  String
  /// 1 = ponedeljek … 7 = nedelja; samo pri scope "weekday"
  weekday Int?
  /// Konkreten dan ob polnoči; samo pri scope "date"
  date    DateTime?
  /// Dodatek v EUR na uro.
  bonusPerHour Float
  label   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([date])
}

/// Dan, ko je lokal zaprt — bodisi vsak tak dan v tednu (npr. vsak ponedeljek)
/// bodisi posamezen datum (dopust, praznik). Urnik se tak dan ne sestavlja.
model ClosedDay {
  id      String    @id @default(cuid())
  /// "weekday" | "date"
  scope   String
  /// 1 = ponedeljek … 7 = nedelja; samo pri scope "weekday"
  weekday Int?
  /// Konkreten dan ob polnoči; samo pri scope "date"
  date    DateTime?
  note    String?

  createdAt DateTime @default(now())

  @@index([scope])
  @@index([date])
}

/// Enovrstična tabela z nastavitvami lokala.
model Settings {
  id String @id @default("default")

  /// Odbijanje ur za zamujanje.
  latePenaltyEnabled       Boolean @default(false)
  /// Zamuda do te meje se ne kaznuje.
  lateToleranceMinutes     Int     @default(0)
  /// Vsak začeti blok te dolžine pomeni en odbitek.
  lateBlockMinutes         Int     @default(15)
  /// Koliko minut dela se odbije za vsak začeti blok zamude.
  latePenaltyMinutesPerBlock Int   @default(60)

  /// Privzete ure posameznega dela dneva; z njimi se prednapolni vpis izmene.
  morningStart String @default("08:00")
  morningEnd   String @default("16:00")
  alldayStart  String @default("10:00")
  alldayEnd    String @default("22:00")
  eveningStart String @default("16:00")
  eveningEnd   String @default("00:00")

  updatedAt DateTime @updatedAt
}

/// Napovedana odsotnost (dopust, bolniška, drugo), ki jo potrdi vodja.
model Absence {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("AbsenceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  /// "dopust" | "bolniska" | "drugo" — glej src/lib/requests.ts
  type       String
  /// Oba dneva sta vključena; hranimo ju ob polnoči.
  startDate  DateTime
  endDate    DateTime
  reason     String?
  /// "pending" | "approved" | "rejected"
  status     String   @default("pending")

  decidedById String?
  decidedBy   Employee? @relation("AbsenceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([status, startDate])
}

/// Oddaja izmene: zaposleni jo ponudi, sodelavec jo prevzame, vodja potrdi.
model ShiftOffer {
  id      String @id @default(cuid())
  shiftId String @unique
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  offeredById String
  offeredBy   Employee @relation("OfferOfferedBy", fields: [offeredById], references: [id], onDelete: Cascade)

  claimedById String?
  claimedBy   Employee? @relation("OfferClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt   DateTime?

  /// "open" | "claimed" | "approved" | "rejected" | "cancelled"
  status String  @default("open")
  note   String?

  decidedById String?
  decidedBy   Employee? @relation("OfferDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
